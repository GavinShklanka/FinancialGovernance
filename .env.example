# ==============================================================================
# Antigravity — Environment Configuration
# Copy this file to .env and fill in your keys.
# NEVER commit the real .env to GitHub.
# ==============================================================================

# ── Core AI ───────────────────────────────────────────────────────────────────
# At minimum, provide ANTHROPIC_API_KEY to power the Claude research layer.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                        # Optional — for GPT-based analysis/embeddings

# ── Market Data APIs ──────────────────────────────────────────────────────────
# Alpha Vantage — stock prices, ETF data, commodities (free tier available)
# Get key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# FRED (Federal Reserve Economic Data) — interest rates, inflation, liquidity
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html  (free)
FRED_API_KEY=

# Trading Economics — commodities, global macro (paid)
TRADINGECONOMICS_API_KEY=

# Nasdaq Data Link (formerly Quandl) — uranium, metals, commodities
# Get key: https://data.nasdaq.com/account/profile  (free tier available)
NASDAQ_DATA_LINK_API_KEY=

# ── News and Event Signals ────────────────────────────────────────────────────
# NewsAPI — cyber incidents, AI infrastructure news, geopolitical events
# Get key: https://newsapi.org/register  (free tier: 100 req/day)
NEWS_API_KEY=

# GDELT — geopolitical monitoring (no key required, but can register)
GDELT_API_KEY=

# ── Claude Research Settings ──────────────────────────────────────────────────
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4000
CLAUDE_TEMPERATURE=0.2

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///antigravity.db
# For production: DATABASE_URL=postgresql://user:password@localhost:5432/antigravity

# ── Governance / Risk Controls ────────────────────────────────────────────────
MAX_SINGLE_POSITION=0.25
MIN_CASH_RESERVE=0.10
MAX_SECTOR_EXPOSURE=0.40

# ── Portfolio Strategy Targets ────────────────────────────────────────────────
PORTFOLIO_GROWTH_TARGET=0.40
PORTFOLIO_INFRASTRUCTURE_TARGET=0.35
PORTFOLIO_DEFENSE_TARGET=0.15
PORTFOLIO_CASH_TARGET=0.10

# ── System Settings ───────────────────────────────────────────────────────────
ANTIGRAVITY_ENV=development
ANTIGRAVITY_LOG_LEVEL=INFO
SIGNAL_REFRESH_INTERVAL=86400          # 86400 seconds = daily refresh

# ── Optional: Real-Time Alerts ────────────────────────────────────────────────
# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Discord / Slack
DISCORD_WEBHOOK=
SLACK_WEBHOOK=
