# Antigravity — .gitignore

# NEVER commit real credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Data outputs (never track raw or processed state)
data/raw/
data/processed/
cache/

# Do not track pipeline final outputs
macro_regime/
portfolio_model.json
decision_graph.json
app/outputs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
gurobi.log
